{
  "name": "lakehouse-daily-etl",
  "description": "End-to-end Bronze → Silver → Gold medallion pipeline",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "lakehouse-cluster",
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "autoscale": {
          "min_workers": 1,
          "max_workers": 4
        },
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true",
          "spark.databricks.io.cache.enabled": "true",
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        },
        "azure_attributes": {
          "availability": "SPOT_WITH_FALLBACK_AZURE",
          "spot_bid_max_price": -1
        },
        "libraries": [
          { "pypi": { "package": "delta-spark==3.0.0" } },
          { "pypi": { "package": "azure-storage-file-datalake==12.14.0" } }
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_ingest",
      "job_cluster_key": "lakehouse-cluster",
      "notebook_task": {
        "notebook_path": "/Shared/lakehouse/bronze/ingest_raw",
        "base_parameters": {
          "source_container": "landing",
          "source_path": "sales/",
          "source_format": "parquet",
          "bronze_table": "sales_raw"
        }
      }
    },
    {
      "task_key": "silver_transform",
      "depends_on": [{ "task_key": "bronze_ingest" }],
      "job_cluster_key": "lakehouse-cluster",
      "notebook_task": {
        "notebook_path": "/Shared/lakehouse/silver/transform_cleanse",
        "base_parameters": {
          "bronze_table": "sales_raw",
          "silver_table": "sales_cleansed",
          "merge_key": "sale_id"
        }
      }
    },
    {
      "task_key": "gold_aggregate",
      "depends_on": [{ "task_key": "silver_transform" }],
      "job_cluster_key": "lakehouse-cluster",
      "notebook_task": {
        "notebook_path": "/Shared/lakehouse/gold/aggregate_serve",
        "base_parameters": {
          "silver_table": "sales_cleansed",
          "gold_table": "sales_summary_monthly"
        }
      }
    }
  ],
  "email_notifications": {
    "on_failure": ["data-platform-team@example.com"],
    "no_alert_for_skipped_runs": true
  }
}
